rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read/write contact form submissions
    match /contacts/{document=**} {
      allow read: if true;
      allow create: if request.resource.data.name != null 
                    && request.resource.data.email != null 
                    && request.resource.data.message != null;
      allow update, delete: if false;
    }

    // Allow authenticated users to read/write orders
    match /orders/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name != null
                    && request.resource.data.email != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Allow authenticated users to read/write their user profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow anyone to read menu
    match /menu/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
